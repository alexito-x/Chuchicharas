# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chuchicharas_db

# JWT Configuration
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_48_BYTES
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REEMPLAZA_CON_OTRO_SECRETO_ALEATORIO_DISTINTO
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Chuchicharas <noreply@chuchicharas.com>"

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Admin bootstrap (used by npm run seed:admin)
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_SEGURA
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Chuchicharas
